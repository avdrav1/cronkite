# Copy to .env.ship (gitignored) and fill in. Never commit real tokens.
# API token scopes: Account > Cloudflare Pages: Edit, Account > Workers R2 Storage: Edit
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET=spreadsheet-releases
CF_PAGES_PROJECT=spreadsheet
# Pages project for Slate's download page at slate.cronkite.cc (scripts/ship.sh slate site)
CF_SLATE_PAGES_PROJECT=slate
# Pages project for Frame's download page at frame.cronkite.cc (scripts/ship.sh frame site)
CF_FRAME_PAGES_PROJECT=frame
# Pages project for Etch's download page at etch.cronkite.cc (scripts/ship.sh etch site)
CF_ETCH_PAGES_PROJECT=etch
# Pages project for the suite page at cronkite.cc (scripts/ship.sh suite-site)
CF_SUITE_PAGES_PROJECT=cronkite
# Public URL of the R2 bucket (custom domain or r2.dev), no trailing slash
DOWNLOAD_BASE_URL=https://dl.example.com
# The private key that signs latest.json (ADR 0012), outside this repository: made by
# `python3 scripts/release_key.py new DIR release-1`. The other release key (release-2)
# stays offline, elsewhere. Set CRONKITE_RELEASE_KEY_PASS too if the key is encrypted.
CRONKITE_RELEASE_KEY=
